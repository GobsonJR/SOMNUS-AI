# Copy to .env.production and replace every value before running the LAN stack.
SOMNUS_LAN_HOST=192.168.1.100
POSTGRES_USER=somnus
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=sleepdb
REDIS_PASSWORD=replace-with-a-long-random-password
MQTT_BROKER=mosquitto
MQTT_PORT=1883
MQTT_USERNAME=somnus_backend
MQTT_PASSWORD=replace-with-a-backend-specific-password
DEVICE_MQTT_USERNAME=esp32_01
DEVICE_MQTT_PASSWORD=replace-with-a-device-specific-password
OPERATOR_PIN_HASH=replace-with-sha256-of-a-shared-demo-pin
CONFIGURED_DEVICE_ID=esp32_01
AUTO_WAKE_ENABLED=false
MODEL_MANIFEST_PATH=app/models/model_manifest.json
MODEL_MIN_N2_F1=0.70
MODEL_MIN_N2_RECALL=0.70
