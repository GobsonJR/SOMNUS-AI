# Add one user section per registered device. A device is allowed only on its own topics.
user esp32_01
topic write somnus/v1/devices/esp32_01/telemetry/rr-epoch
topic write somnus/v1/devices/esp32_01/events/alarm
topic write somnus/v1/devices/esp32_01/status
topic write somnus/v1/devices/esp32_01/errors
topic read somnus/v1/devices/esp32_01/commands/alarm

# The backend is authenticated as a broker administrator and consumes device telemetry.
user somnus_backend
topic readwrite somnus/v1/devices/#
