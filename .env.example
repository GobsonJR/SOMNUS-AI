# Database
DATABASE_URL=postgresql+asyncpg://somnus:somnus@localhost:5432/sleepdb

# MQTT (optional when ESP32 uses HTTP ingest)
MQTT_BROKER=localhost
MQTT_PORT=1883

# Redis
REDIS_URL=redis://localhost:6379/0

# Device expected by /ready (must match firmware DEVICE_ID)
CONFIGURED_DEVICE_ID=esp32_01

# ML models (paths relative to backend/ when running uvicorn from backend/)
MODEL_N2_PATH=app/models/model_n2.onnx
MODEL_STAGE_PATH=app/models/model_stage.onnx
FEATURE_COLUMNS_PATH=app/models/feature_columns.json
MODEL_MANIFEST_PATH=app/models/model_manifest.json

# Allow ONNX inference without signed manifest (local dev / lab demo)
DEV_INFERENCE_ENABLED=true

# Smart wake
THETA=0.70
K_CONSECUTIVE=3
WINDOW_MINUTES_DEFAULT=30
AUTO_WAKE_ENABLED=false
